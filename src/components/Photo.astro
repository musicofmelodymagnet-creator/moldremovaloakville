---
// Фото контента. Пока снимка нет (image не передан) — серая заглушка того же размера,
// поэтому при замене на реальное фото макет не сдвинется (без CLS).
// Реальные фото: положить в src/assets/…, импортировать и передать как image —
// Astro сам сделает AVIF/WebP, srcset и width/height.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  class?: string;
  /** Hero / первый экран: без lazy-load, высокий приоритет загрузки */
  priority?: boolean;
  sizes?: string;
  /** Показывать подпись «что здесь будет» на заглушке */
  hint?: boolean;
  /** Совсем пустая заглушка (фон hero) */
  bare?: boolean;
}
const { image, alt, class: cls = '', priority = false, sizes = '(min-width: 1024px) 33vw, 100vw', hint = true, bare = false } = Astro.props;
---
{image ? (
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    class:list={['h-full w-full object-cover', cls]}
  />
) : (
  <div
    role="img"
    aria-label={alt}
    class:list={['relative flex h-full w-full items-center justify-center overflow-hidden bg-[#d8d5d0]', cls]}
  >
    <div class="absolute inset-0 bg-[linear-gradient(135deg,transparent_48%,rgba(255,255,255,.35)_50%,transparent_52%)] bg-[size:28px_28px] opacity-40" aria-hidden="true"></div>
    {!bare && <div class="relative flex flex-col items-center gap-2 px-6 text-center text-[#8d8780]">
      <Icon name="image" class="size-8" />
      {hint && <span class="max-w-[22ch] text-xs leading-snug font-medium">Photo coming soon</span>}
    </div>}
  </div>
)}
