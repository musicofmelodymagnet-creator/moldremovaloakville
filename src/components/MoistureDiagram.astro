---
// УТП №1 — временная собственная инфографика «разрез стены»:
// Visible Spot → Hidden Moisture Path → Measured Affected Area → Targeted Removal.
// Место под будущую финальную инфографику: можно заменить SVG на изображение, подписи оставить HTML-текстом.
interface Props { labels: string[] }
const { labels } = Astro.props;
const colors = ['bg-terracotta-800', 'bg-sage-600', 'bg-gold', 'bg-terracotta-700'];
---
<figure class="card p-6 sm:p-10">
  <div class="grid items-center gap-8 sm:grid-cols-2">
    <svg viewBox="0 0 260 360" class="mx-auto w-full max-w-[320px]" role="img" aria-labelledby="md-title">
      <title id="md-title">Wall cross-section: a visible spot, the hidden moisture path behind it, the measured affected area and the targeted removal zone</title>
      <!-- wall cavity -->
      <rect x="20" y="10" width="220" height="340" rx="14" fill="#f3ede3" />
      <!-- studs -->
      <rect x="20" y="10" width="16" height="340" fill="#e2d6c3" />
      <rect x="224" y="10" width="16" height="340" fill="#e2d6c3" />
      <rect x="122" y="10" width="16" height="340" fill="#e2d6c3" />
      <!-- 3: measured affected area -->
      <rect x="44" y="120" width="172" height="190" rx="10" fill="#d4af72" fill-opacity=".22" stroke="#8a6a2f" stroke-width="2" stroke-dasharray="6 6" />
      <!-- 4: targeted removal -->
      <rect x="60" y="190" width="120" height="104" rx="8" fill="#c57a5a" fill-opacity=".22" stroke="#9a5235" stroke-width="2.5" />
      <!-- 2: hidden moisture path (leak entering at top, travelling down) -->
      <path d="M200 18 C200 70, 176 92, 170 130 S 120 190, 112 230 S 96 280, 92 300" fill="none" stroke="#6e7b65" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 12" />
      <circle cx="200" cy="22" r="7" fill="#6e7b65" />
      <!-- 1: visible spot -->
      <ellipse cx="96" cy="252" rx="26" ry="20" fill="#7f4229" fill-opacity=".85" />
      <ellipse cx="116" cy="268" rx="10" ry="8" fill="#7f4229" fill-opacity=".6" />
      <ellipse cx="78" cy="236" rx="7" ry="6" fill="#7f4229" fill-opacity=".5" />
      <!-- markers -->
      {[[96, 252], [186, 82], [56, 300], [166, 280]].map(([x, y], i) => (
        <g>
          <circle cx={x} cy={y} r="13" fill="#2e2a26" />
          <text x={x} y={y + 4.5} text-anchor="middle" font-size="13" font-weight="700" fill="#fff" font-family="Inter, sans-serif">{i + 1}</text>
        </g>
      ))}
    </svg>

    <ol class="space-y-2">
      {labels.map((l, i) => (
        <li>
          <div class="flex items-center gap-4 rounded-2xl bg-ivory-50 p-4">
            <span class:list={['grid size-9 shrink-0 place-items-center rounded-full font-display font-bold text-white', colors[i]]}>{i + 1}</span>
            <span class="font-display text-lg font-bold">{l}</span>
          </div>
          {i < labels.length - 1 && <div class="ml-[2.05rem] h-4 w-px bg-ink/20" aria-hidden="true"></div>}
        </li>
      ))}
    </ol>
  </div>
</figure>
