---
// Кнопка звонка + рукописная пометка со стрелкой к ней (шрифт font-hand).
// \n в note — перенос строки. Без подтверждённого телефона в production не выводится ничего.
import PhoneButton from './PhoneButton.astro';
import { site, SHOW_DRAFT } from '../data/site';
interface Props { note: string; class?: string }
const { note, class: cls = '' } = Astro.props;
const show = Boolean(site.phoneE164) || SHOW_DRAFT;
---
{show && (
  <div class:list={['flex flex-wrap items-center gap-3', cls]}>
    <PhoneButton label="call" class="btn-primary text-lg" />
    <span class="flex items-center gap-1 pl-1 font-hand text-[1.7rem] leading-[0.95] text-ink sm:text-[1.9rem]" aria-hidden="true">
      <svg class="mt-3 h-8 w-12 shrink-0 -scale-x-100 rotate-[40deg] sm:rotate-0" viewBox="0 0 48 32" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9c8 12 21 15 37 11" /><path d="M33 13l8 7-9 5" /></svg>
      <span class="rotate-6 whitespace-pre-line">{note}</span>
    </span>
  </div>
)}
