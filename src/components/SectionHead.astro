---
interface Props {
  eyebrow?: string; title: string; intro?: string; center?: boolean; id?: string; class?: string;
  /** dark — для разделов на тёмном фоне (bg-sage-900) */
  tone?: 'light' | 'dark';
  /** шире стандартных max-w-3xl — для длинных заголовков в 2 строки */
  wide?: boolean;
  /** xl — заголовок крупнее обычного h-section */
  size?: 'base' | 'xl';
}
const { eyebrow, title, intro, center = false, id, class: cls = '', tone = 'light', wide = false, size = 'base' } = Astro.props;
const dark = tone === 'dark';
---
<div class:list={[wide ? 'max-w-5xl' : 'max-w-3xl', center && 'mx-auto text-center', cls]}>
  {eyebrow && (
    <p class:list={[dark ? 'inline-flex items-center gap-3 text-xs font-semibold tracking-[0.22em] text-gold uppercase' : 'eyebrow', center && 'justify-center']}>
      <span class:list={['h-px w-8', dark ? 'bg-gold' : 'bg-terracotta']} aria-hidden="true"></span>{eyebrow}
    </p>
  )}
  <h2 id={id} class:list={[
    size === 'xl' ? 'font-display text-5xl leading-[1.02] font-extrabold sm:text-6xl lg:text-7xl' : 'h-section',
    'whitespace-pre-line', dark && 'text-white', eyebrow && 'mt-5',
  ]}>{title}</h2>
  {intro && <p class:list={['lead mt-7', center && 'mx-auto', dark && 'text-white/75']}>{intro}</p>}
  <slot />
</div>
