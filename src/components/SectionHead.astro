---
interface Props { eyebrow?: string; title: string; intro?: string; center?: boolean; id?: string; class?: string }
const { eyebrow, title, intro, center = false, id, class: cls = '' } = Astro.props;
---
<div class:list={['max-w-3xl', center && 'mx-auto text-center', cls]}>
  {eyebrow && (
    <p class:list={['eyebrow', center && 'justify-center']}>
      <span class="h-px w-8 bg-terracotta" aria-hidden="true"></span>{eyebrow}
    </p>
  )}
  <h2 id={id} class:list={['h-section', eyebrow && 'mt-5']}>{title}</h2>
  {intro && <p class:list={['lead mt-7', center && 'mx-auto']}>{intro}</p>}
  <slot />
</div>
