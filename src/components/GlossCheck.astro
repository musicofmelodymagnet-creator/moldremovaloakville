---
// Глянцевая зелёная галочка в стиле эмблем (зелёный градиент, белый ободок, блик).
// uid — уникальный суффикс для id градиентов, когда галочек на странице несколько.
interface Props { class?: string; uid: string | number }
const { class: cls = 'size-10', uid } = Astro.props;
const g = `gc-g-${uid}`, h = `gc-h-${uid}`;
---
<svg class={cls} viewBox="0 0 40 40" aria-hidden="true">
  <defs>
    <linearGradient id={g} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7ccf4a" /><stop offset="1" stop-color="#1e7a2c" /></linearGradient>
    <linearGradient id={h} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".75" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
  </defs>
  <circle cx="20" cy="21" r="18" fill="#14531d" opacity=".18" />
  <circle cx="20" cy="20" r="18" fill="#fff" />
  <circle cx="20" cy="20" r="15.5" fill={`url(#${g})`} />
  <ellipse cx="20" cy="12.5" rx="10.5" ry="6" fill={`url(#${h})`} />
  <path d="M12.5 20.5l5 5 10-11" fill="none" stroke="#0f4a17" stroke-opacity=".35" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" transform="translate(0 1)" />
  <path d="M12.5 20.5l5 5 10-11" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
</svg>
