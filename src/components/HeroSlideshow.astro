---
// Лёгкое слайдшоу hero без библиотек. Первый слайд грузится с высоким приоритетом, остальные — lazy.
// Без JS виден первый слайд. С prefers-reduced-motion автопрокрутка выключена.
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';

interface Props { slides: { alt: string; image?: ImageMetadata }[] }
const { slides } = Astro.props;
---
<div class="absolute inset-0" data-slideshow aria-roledescription="carousel" aria-label="Project photos">
  {slides.map((s, i) => (
    <div
      class:list={['absolute inset-0 transition-opacity duration-1000 ease-out-soft', i === 0 ? 'opacity-100' : 'opacity-0']}
      data-slide
      aria-roledescription="slide"
      aria-label={`${i + 1} of ${slides.length}`}
      aria-hidden={i === 0 ? 'false' : 'true'}
    >
      <Photo image={s.image} alt={s.alt} priority={i === 0} sizes="(min-width: 1024px) 66vw, 100vw" hint={false} bare class="object-[68%_12%]" />
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    if (slides.length < 2) return;
    let index = 0;
    let timer: number | undefined;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const show = (n: number) => {
      index = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-100', i === index);
        s.classList.toggle('opacity-0', i !== index);
        s.setAttribute('aria-hidden', String(i !== index));
      });
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === index)));
    };
    const stop = () => window.clearInterval(timer);
    const start = () => { if (!reduce) { stop(); timer = window.setInterval(() => show(index + 1), 6000); } };

    hero.querySelector('[data-prev]')?.addEventListener('click', () => { show(index - 1); start(); });
    hero.querySelector('[data-next]')?.addEventListener('click', () => { show(index + 1); start(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
    hero.addEventListener('focusin', stop);
    hero.addEventListener('focusout', start);
    start();
  });
</script>
