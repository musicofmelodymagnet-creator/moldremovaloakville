---
// Лёгкое слайдшоу hero без библиотек. Первый слайд грузится с высоким приоритетом, остальные — lazy.
// Без JS виден первый слайд. С prefers-reduced-motion автопрокрутка выключена.
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';

interface Props { slides: { alt: string; image?: ImageMetadata }[] }
const { slides } = Astro.props;
---
<div class="absolute inset-0" data-slideshow aria-roledescription="carousel" aria-label="Project photos">
  {slides.map((s, i) => (
    <div
      class:list={['absolute inset-0 transition-opacity duration-1000 ease-out-soft', i === 0 ? 'opacity-100' : 'opacity-0']}
      data-slide
      aria-roledescription="slide"
      aria-label={`${i + 1} of ${slides.length}`}
      aria-hidden={i === 0 ? 'false' : 'true'}
    >
      <Photo image={s.image} alt={s.alt} priority={i === 0} sizes="(min-width: 1280px) 784px, (min-width: 1024px) 62vw, 100vw" hint={false} bare class="object-[68%_12%]" />
    </div>
  ))}
</div>

<script>
  // Один таймер на фото и фразы: каждые 3,5 с меняется слайд и одновременно — фраза.
  // Фраза выбирается случайно (не повторяя текущую) и не привязана к конкретному фото.
  const INTERVAL = 3500;
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const phrases = [...hero.querySelectorAll<HTMLElement>('[data-rotate]')];
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (slides.length < 2 && phrases.length < 2) return;

    const activate = (list: HTMLElement[], index: number) =>
      list.forEach((el, n) => {
        el.classList.toggle('opacity-100', n === index);
        el.classList.toggle('opacity-0', n !== index);
        if (n === index) el.removeAttribute('aria-hidden'); else el.setAttribute('aria-hidden', 'true');
      });

    let slide = 0;
    let phrase = 0;
    window.setInterval(() => {
      if (slides.length > 1) { slide = (slide + 1) % slides.length; activate(slides, slide); }
      if (phrases.length > 1) {
        let next = phrase;
        while (next === phrase) next = Math.floor(Math.random() * phrases.length);
        phrase = next;
        activate(phrases, phrase);
      }
    }, INTERVAL);
  });
</script>
