---
// Лёгкое слайдшоу hero без библиотек. Первый слайд грузится с высоким приоритетом, остальные — lazy.
// Без JS виден первый слайд. С prefers-reduced-motion автопрокрутка выключена.
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';

interface Props { slides: { alt: string; image?: ImageMetadata }[] }
const { slides } = Astro.props;
---
<div class="absolute inset-0" data-slideshow aria-roledescription="carousel" aria-label="Project photos">
  {slides.map((s, i) => (
    <div
      class:list={['absolute inset-0 transition-opacity duration-1000 ease-out-soft', i === 0 ? 'opacity-100' : 'opacity-0']}
      data-slide
      aria-roledescription="slide"
      aria-label={`${i + 1} of ${slides.length}`}
      aria-hidden={i === 0 ? 'false' : 'true'}
    >
      <Photo image={s.image} alt={s.alt} priority={i === 0} sizes="(min-width: 1280px) 784px, (min-width: 1024px) 62vw, 100vw" hint={false} bare class="object-[68%_12%]" />
    </div>
  ))}
</div>

<script>
  // Автосмена слайдов без ручного листания; индикатор (data-dot) только показывает текущий слайд.
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...hero.querySelectorAll<HTMLElement>('[data-dot]')];
    if (slides.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let index = 0;
    window.setInterval(() => {
      index = (index + 1) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-100', i === index);
        s.classList.toggle('opacity-0', i !== index);
        s.setAttribute('aria-hidden', String(i !== index));
      });
      dots.forEach((d, i) => d.toggleAttribute('data-active', i === index));
    }, 6000);
  });
</script>
